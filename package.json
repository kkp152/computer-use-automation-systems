{
  "name": "computer-use-automation-system",
  "version": "1.0.0",
  "description": "Deterministic computer-use automation and capability recording for legacy banking software",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "app": "tsx src/target-app/server.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "replay:outcome": "tsx src/cli.ts replay --member 99999",
    "replay:escalate": "tsx src/cli.ts replay --simulate-blocker",
    "catalog": "tsx src/cli.ts catalog",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "computer-use",
    "playwright",
    "llm-agents",
    "banking-automation",
    "deterministic-replay"
  ],
  "author": "interface.ai Candidate",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
